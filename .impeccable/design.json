  "narrative": {
    "northStar": "纸上的牌友脸",
    "overview": "界面像摊开的记分本：白纸底、黑墨线、方框里的 Noto 简笔画脸。主按钮是墨黑胶囊、白字。记分员在桌上单手操作时，界面应安静可读。俏皮来自脸和线，不来自贴纸墙或像素农庄菜单。这是 product 工具 UI：熟悉、可点、信息优先。简笔画服务于认人和情绪，不做成头像工坊 landing page。密度跟着任务走。战场页信息紧，首页可稍松。明确拒绝：过于幼齿的贴纸 / 表情包堆砌风；微信默认灰白表单、无个性后台感；电竞暗黑麻将客户端；已退役的星露谷草地绿 / 木框 / 羊皮纸。也拒绝把 MVP 的 #111 / #1a1a1a 暗底当作品牌默认。",
    "keyCharacteristics": [
      "白纸底 + 白板块，永不默认暗黑",
      "墨黑主 CTA；金标仅用于「庄」",
      "扁平：深度靠粗墨边与色阶，不靠大阴影",
      "方框头像（不圆形）+ 胶囊按钮",
      "微信小程序实现：尺寸以 rpx 落地（本文 px ≈ 设计稿 1×，小程序约 ×2 rpx）"
    ],
    "rules": [
      {
        "name": "The Paper Rule",
        "body": "默认表面必须是 Paper / Panel。禁止把暗黑 #111/#1a1a1a 或电竞黑底当作默认主题。本期不做暗色对翻。",
        "section": "colors"
      },
      {
        "name": "The Ink Button Rule",
        "body": "主行动只用 Ink 填色 + 白字。选中 chip 同语言。禁止草地绿、禁止 Peach 当按钮。",
        "section": "colors"
      },
      {
        "name": "The Scarce Gold Rule",
        "body": "Dealer 金标专留给庄家及相关高价值状态；普通按钮、榜单行、装饰条不得用金。",
        "section": "colors"
      },
      {
        "name": "The Peach Illustration Rule",
        "body": "Peach 只出现在简笔画内部，或角色卡选中格的浅洗。不得铺页面底、不得填 CTA。",
        "section": "colors"
      },
      {
        "name": "The System Type Rule",
        "body": "不引入第二字体族做「更可爱」。可爱来自脸与墨线，不来自花字。",
        "section": "typography"
      },
      {
        "name": "The Thumb Label Rule",
        "body": "战场与录胡路径上的可点标签 ≥13px（~26rpx）；关键确认按钮字号 ≥16px（~32rpx）。",
        "section": "typography"
      },
      {
        "name": "The Ink Frame Rule",
        "body": "可交互块用 2–3px（~4–6rpx）实色 Ink 边框。边框即深度；禁止用宽模糊阴影冒充层次。",
        "section": "elevation"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "休息态表面扁平。状态变化用边框色、填充色、字色，不用位移阴影。",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do 用 Paper 作页面底、Panel 作块面，保持「纸上的牌友脸」。",
      "Do 主行动只用 Ink 填色，并保证白字清晰。",
      "Do 用粗墨边表达可点与选中，而不是阴影。",
      "Do 庄状态用 Dealer 金且保持稀缺。",
      "Do 战场与录胡路径优先大热区、短路径（桌上优先）。",
      "Do 头像用方框里的简笔画 PNG/SVG。"
    ],
    "donts": [
      "Don't 使用过于幼齿的贴纸 / 表情包堆砌风。",
      "Don't 退回微信默认灰白表单、无个性后台感。",
      "Don't 做成电竞暗黑麻将客户端。",
      "Don't 把 MVP 暗底 #111 / #1a1a1a 当作成品主题。",
      "Don't 给按钮/卡片加宽模糊大阴影。",
      "Don't 大面积铺 Dealer 金，或把 Peach / 旧草地绿当背景或 CTA。",
      "Don't 用渐变字、侧边彩条、玻璃拟态、假手绘浪边。",
      "Don't 把 notion-avatar.app 的 landing 结构搬进记分工具。"
    ]
  }
}
