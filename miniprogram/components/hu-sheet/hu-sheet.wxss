@import "../../styles/tokens.wxss";

.mask {
  --paper: #fffefc;
  --panel: #ffffff;
  --ink: #1c1917;
  --muted: #5c574f;
  --on-fill: #ffffff;
  --gain: #2f7d4a;
  --loss: #c45c4a;
  --stroke: 6rpx;
  --stroke-thin: 4rpx;
  --radius-tile: 16rpx;
  --radius-pill: 999rpx;
  --mask: rgba(28, 25, 23, 0.45);
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--mask);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  max-height: 88vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--panel);
  border-radius: 24rpx 24rpx 0 0;
  border-top: var(--stroke) solid var(--ink);
  display: flex;
  flex-direction: column;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.close {
  font-size: 28rpx;
  color: var(--muted);
  padding: 8rpx 12rpx;
}

.body {
  flex: 1;
  max-height: 62vh;
  margin-bottom: 16rpx;
}

.block {
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.row--fans {
  margin-bottom: 0;
}

.chip {
  padding: 14rpx 24rpx;
  border-radius: var(--radius-tile);
  background: var(--panel);
  color: var(--ink);
  font-size: 26rpx;
  border: var(--stroke-thin) solid var(--ink);
}

.chip--fan {
  min-width: 140rpx;
  text-align: center;
}

.chip--on {
  background: var(--ink);
  border-color: var(--ink);
  color: var(--on-fill);
  font-weight: 600;
}

.steppers {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stepper-label {
  font-size: 28rpx;
  color: var(--ink);
}

.stepper-ctrl {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 36rpx;
  color: var(--ink);
  background: var(--panel);
  border-radius: var(--radius-tile);
  border: var(--stroke-thin) solid var(--ink);
}

.step-val {
  min-width: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.preview {
  margin: 8rpx 0 12rpx;
  padding: 20rpx;
  background: var(--paper);
  border-radius: var(--radius-tile);
  border: var(--stroke-thin) solid var(--ink);
}

.preview-summary {
  display: block;
  font-size: 26rpx;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.preview-line {
  font-size: 26rpx;
  color: var(--gain);
  padding: 4rpx 0;
}

.preview-hint {
  font-size: 26rpx;
  color: var(--muted);
}

.confirm {
  flex-shrink: 0;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--on-fill);
  background: var(--ink);
  border-radius: var(--radius-pill);
  border: var(--stroke) solid var(--ink);
  margin: 0;
}

.confirm::after {
  border: none;
}

.confirm[disabled] {
  opacity: 0.45;
}
