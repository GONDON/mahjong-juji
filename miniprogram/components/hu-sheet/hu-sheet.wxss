.mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  max-height: 88vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom));
  background: #222222;
  border-radius: 24rpx 24rpx 0 0;
  display: flex;
  flex-direction: column;
}

.head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  flex-shrink: 0;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.close {
  font-size: 28rpx;
  color: #888888;
  padding: 8rpx 12rpx;
}

.body {
  flex: 1;
  max-height: 62vh;
  margin-bottom: 16rpx;
}

.block {
  margin-bottom: 20rpx;
}

.label {
  display: block;
  font-size: 24rpx;
  color: #888888;
  margin-bottom: 12rpx;
}

.row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}

.row--fans {
  margin-bottom: 0;
}

.chip {
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  background: #333333;
  color: #cccccc;
  font-size: 26rpx;
  border: 2rpx solid #444444;
}

.chip--fan {
  min-width: 140rpx;
  text-align: center;
}

.chip--on {
  background: #3d4a2a;
  border-color: #8aba4a;
  color: #ffffff;
  font-weight: 600;
}

.steppers {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stepper-label {
  font-size: 28rpx;
  color: #cccccc;
}

.stepper-ctrl {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.step-btn {
  width: 64rpx;
  height: 64rpx;
  line-height: 60rpx;
  text-align: center;
  font-size: 36rpx;
  color: #ffffff;
  background: #3a3a3a;
  border-radius: 12rpx;
  border: 2rpx solid #555555;
}

.step-val {
  min-width: 48rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.preview {
  margin: 8rpx 0 12rpx;
  padding: 20rpx;
  background: #1a1a1a;
  border-radius: 12rpx;
  border: 1rpx solid #333333;
}

.preview-summary {
  display: block;
  font-size: 26rpx;
  color: #e0e0e0;
  margin-bottom: 12rpx;
}

.preview-line {
  font-size: 26rpx;
  color: #8aba4a;
  padding: 4rpx 0;
}

.preview-hint {
  font-size: 26rpx;
  color: #888888;
}

.confirm {
  flex-shrink: 0;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: #4a7c4a;
  border-radius: 16rpx;
  border: none;
  margin: 0;
}

.confirm[disabled] {
  opacity: 0.45;
}
