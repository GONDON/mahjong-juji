.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
  background: var(--paper);
  color: var(--ink);
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: var(--muted);
  font-size: 30rpx;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.room {
  display: block;
  font-size: 28rpx;
  color: var(--muted);
  margin-bottom: 16rpx;
}

.sub {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  line-height: 1.5;
}

.roster {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 36rpx;
}

.roster-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.roster-item--seated {
  opacity: 0.45;
}

.roster-face {
  width: 88rpx;
  height: 88rpx;
  border: var(--stroke) solid var(--ink);
  border-radius: var(--radius-tile);
  background: var(--panel);
  box-sizing: border-box;
}

.roster-name {
  margin-top: 8rpx;
  max-width: 120rpx;
  font-size: 22rpx;
  color: var(--ink);
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
  margin-bottom: 56rpx;
}

.seat-btn {
  position: relative;
  min-height: 260rpx;
  padding: 28rpx 20rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--panel);
  border-radius: var(--radius-tile);
  border: var(--stroke-thin) solid var(--ink);
}

.seat-btn--on {
  border-width: var(--stroke);
  background: var(--peach-wash);
}

.seat-face-hit {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  padding: 8rpx;
  box-sizing: border-box;
}

.seat-face {
  width: 88rpx;
  height: 88rpx;
  border: var(--stroke) solid var(--ink);
  border-radius: var(--radius-tile);
  background: var(--panel);
  box-sizing: border-box;
}

.seat-index {
  font-size: 24rpx;
  color: var(--muted);
}

.seat-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  text-align: center;
  word-break: break-all;
}

.dealer-chip {
  margin-top: 16rpx;
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 20rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
  background: var(--panel);
  border: var(--stroke-thin) solid var(--ink);
  border-radius: var(--radius-pill);
}

.seat-btn--on .dealer-chip {
  background: var(--dealer);
  border-color: var(--dealer);
}

.confirm-btn {
  height: 100rpx;
  line-height: 100rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--on-fill);
  background: var(--ink);
  border-radius: var(--radius-pill);
  border: var(--stroke) solid var(--ink);
}

.confirm-btn::after {
  border: none;
}

.confirm-btn[disabled] {
  opacity: 0.45;
}
