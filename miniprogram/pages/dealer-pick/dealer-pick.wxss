.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
  background: #1a1a1a;
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: #888888;
  font-size: 30rpx;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.room {
  display: block;
  font-size: 28rpx;
  color: #7a9a7a;
  margin-bottom: 16rpx;
}

.sub {
  display: block;
  font-size: 26rpx;
  color: #888888;
  line-height: 1.5;
}

.roster {
  width: 100%;
  white-space: nowrap;
  margin-bottom: 36rpx;
}

.roster-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  width: 120rpx;
  margin-right: 20rpx;
  vertical-align: top;
}

.roster-item--seated {
  opacity: 0.45;
}

.roster-face {
  width: 88rpx;
  height: 88rpx;
  border: 6rpx solid #26190c;
  border-radius: 8rpx;
  background: #fff8f4;
  box-sizing: border-box;
}

.roster-name {
  margin-top: 8rpx;
  max-width: 120rpx;
  font-size: 22rpx;
  color: #cccccc;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.seat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
  margin-bottom: 56rpx;
}

.seat-btn {
  position: relative;
  min-height: 260rpx;
  padding: 28rpx 20rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #2a2a2a;
  border-radius: 20rpx;
  border: 4rpx solid #3a3a3a;
}

.seat-btn--on {
  background: #3d4a2a;
  border-color: #8aba4a;
}

.seat-face-hit {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  padding: 8rpx;
  box-sizing: border-box;
}

.seat-face {
  width: 88rpx;
  height: 88rpx;
  border: 6rpx solid #26190c;
  border-radius: 8rpx;
  background: #fff8f4;
  box-sizing: border-box;
}

.seat-index {
  font-size: 24rpx;
  color: #888888;
}

.seat-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  word-break: break-all;
}

.dealer-chip {
  margin-top: 16rpx;
  min-width: 96rpx;
  height: 56rpx;
  padding: 0 20rpx;
  line-height: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  background: #8aba4a;
  border-radius: 12rpx;
}

.seat-btn--on .dealer-chip {
  background: #c8e08a;
}

.confirm-btn {
  height: 100rpx;
  line-height: 100rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  background: #4a7c4a;
  border-radius: 16rpx;
  border: none;
}

.confirm-btn[disabled] {
  opacity: 0.45;
}
