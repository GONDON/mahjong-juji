.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
  background: #1a1a1a;
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: #888888;
  font-size: 30rpx;
}

.header {
  margin-bottom: 48rpx;
}

.title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.room {
  display: block;
  font-size: 28rpx;
  color: #7a9a7a;
  margin-bottom: 16rpx;
}

.sub {
  display: block;
  font-size: 26rpx;
  color: #888888;
  line-height: 1.5;
}

.seat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 28rpx;
  margin-bottom: 56rpx;
}

.seat-btn {
  min-height: 220rpx;
  padding: 36rpx 24rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #2a2a2a;
  border-radius: 20rpx;
  border: 4rpx solid #3a3a3a;
}

.seat-btn--on {
  background: #3d4a2a;
  border-color: #8aba4a;
}

.seat-index {
  font-size: 24rpx;
  color: #888888;
}

.seat-name {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  text-align: center;
  word-break: break-all;
}

.confirm-btn {
  height: 100rpx;
  line-height: 100rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  background: #4a7c4a;
  border-radius: 16rpx;
  border: none;
}

.confirm-btn[disabled] {
  opacity: 0.45;
}
