<view class="page">
  <view wx:if="{{loading}}" class="hint">加载中…</view>

  <block wx:else>
    <view class="header">
      <text class="title">选择本轮首庄</text>
      <text wx:if="{{roomCode}}" class="room">房间码 {{roomCode}}</text>
      <text class="sub">点头像占座；记分员点「庄」选庄后确认开局</text>
    </view>

    <scroll-view wx:if="{{members.length}}" class="roster" scroll-x>
      <view
        wx:for="{{members}}"
        wx:key="openId"
        class="roster-item {{item.seated ? 'roster-item--seated' : ''}}"
      >
        <image class="roster-face" src="{{item.src}}" mode="aspectFit" />
        <text class="roster-name">{{item.nickname}}</text>
      </view>
    </scroll-view>
    <view wx:else class="empty-state">
      <image class="empty-state-img" src="/assets/empty.svg" mode="aspectFit" />
      <text>牌友进房后会出现在这里。点座位占座。</text>
    </view>

    <view class="seat-grid">
      <view
        wx:for="{{seats}}"
        wx:key="playerId"
        class="seat-btn {{selectedId === item.playerId ? 'seat-btn--on' : ''}}"
      >
        <view
          class="seat-face-hit"
          data-id="{{item.playerId}}"
          bindtap="onSeatFaceTap"
        >
          <image class="seat-face" src="{{item.faceSrc}}" mode="aspectFit" />
          <text class="seat-index">座位 {{index + 1}}</text>
          <text class="seat-name">{{item.nickname}}</text>
        </view>
        <view
          wx:if="{{isScorer}}"
          class="dealer-chip"
          data-id="{{item.playerId}}"
          catchtap="onSelectDealer"
        >庄</view>
      </view>
    </view>

    <button
      wx:if="{{isScorer}}"
      class="confirm-btn"
      loading="{{confirming}}"
      disabled="{{confirming || !selectedId}}"
      bindtap="onConfirm"
    >确认庄家，开始本轮</button>
    <view wx:else class="hint">仅计分员可选庄开局</view>
  </block>
</view>
