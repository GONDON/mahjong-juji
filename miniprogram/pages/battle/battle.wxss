.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
  background: #1a1a1a;
  display: flex;
  flex-direction: column;
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: #888888;
  font-size: 30rpx;
}

.topbar {
  padding: 16rpx 8rpx 28rpx;
}

.topbar-main {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #f0f0f0;
  margin-bottom: 8rpx;
}

.topbar-sub {
  display: block;
  font-size: 24rpx;
  color: #7a9a7a;
}

.table {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  min-height: 620rpx;
  justify-content: center;
}

.seat-mid {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
}

.table-center {
  flex: 1;
  min-height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #222922;
  border-radius: 16rpx;
  border: 2rpx dashed #3a4a3a;
}

.center-label {
  font-size: 24rpx;
  color: #666666;
}

.seat {
  position: relative;
  padding: 28rpx 20rpx;
  box-sizing: border-box;
  background: #2a2a2a;
  border-radius: 16rpx;
  border: 4rpx solid #3a3a3a;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.seat--top,
.seat--bottom {
  width: 70%;
  align-self: center;
  min-height: 160rpx;
}

.seat--side {
  width: 220rpx;
  min-height: 200rpx;
}

.seat--dealer {
  border-color: #c9a227;
  background: #2f2a1a;
}

.seat--hu {
  opacity: 0.45;
  background: #242424;
  border-color: #333333;
}

.seat-pos {
  font-size: 22rpx;
  color: #888888;
}

.seat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  text-align: center;
  word-break: break-all;
}

.seat-chips {
  font-size: 56rpx;
  font-weight: 700;
  color: #e8e8e8;
  line-height: 1.1;
}

.seat-hu {
  font-size: 22rpx;
  color: #999999;
}

.seat-dealer-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #1a1a1a;
  background: #c9a227;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}

.bottombar {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.bar-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #ffffff;
  background: #3a3a3a;
  border-radius: 14rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.bar-btn--ghost {
  background: transparent;
  color: #7a9a7a;
  border: 2rpx solid #3a4a3a;
}

.bar-btn[disabled] {
  opacity: 0.4;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background: #222222;
  border-radius: 24rpx 24rpx 0 0;
}

.settle-sheet {
  align-self: center;
  width: 86%;
  border-radius: 20rpx;
  margin-bottom: 80rpx;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #ffffff;
}

.confirm-btn {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  background: #4a7c4a;
  border-radius: 16rpx;
  border: none;
  margin-top: 8rpx;
}

.settle-list {
  margin: 28rpx 0 36rpx;
}

.settle-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #333333;
}

.settle-name {
  flex: 1;
  font-size: 30rpx;
  color: #ffffff;
}

.settle-delta {
  font-size: 26rpx;
  color: #888888;
}

.settle-yuan {
  font-size: 30rpx;
  font-weight: 600;
  min-width: 140rpx;
  text-align: right;
}

.settle-yuan.up {
  color: #8aba4a;
}

.settle-yuan.down {
  color: #c76b6b;
}

.end-btn {
  margin-top: 20rpx;
  width: 100%;
}
