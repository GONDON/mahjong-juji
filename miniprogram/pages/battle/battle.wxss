.page {
  min-height: 100vh;
  padding: 24rpx 28rpx 40rpx;
  box-sizing: border-box;
  background: var(--paper);
  display: flex;
  flex-direction: column;
  color: var(--ink);
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: var(--muted);
  font-size: 30rpx;
}

.topbar {
  padding: 16rpx 8rpx 28rpx;
}

.topbar-main {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.topbar-sub {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
}

.presence {
  width: 100%;
  white-space: nowrap;
  margin: 0 0 16rpx;
  height: 64rpx;
}

.presence-face {
  display: inline-block;
  width: 56rpx;
  height: 56rpx;
  margin-right: 12rpx;
  border: var(--stroke) solid var(--ink);
  border-radius: var(--radius-tile);
  background: var(--panel);
  box-sizing: border-box;
  vertical-align: middle;
}

.seat-face {
  width: 72rpx;
  height: 72rpx;
  border: var(--stroke) solid var(--ink);
  border-radius: var(--radius-tile);
  background: var(--panel);
  box-sizing: border-box;
}

.table {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  min-height: 620rpx;
  justify-content: center;
}

.seat-mid {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  gap: 16rpx;
}

.table-center {
  flex: 1;
  min-height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--panel);
  border-radius: var(--radius-tile);
  border: var(--stroke-thin) dashed var(--ink);
}

.center-label {
  font-size: 24rpx;
  color: var(--muted);
}

.seat {
  position: relative;
  padding: 28rpx 20rpx;
  box-sizing: border-box;
  background: var(--panel);
  border-radius: var(--radius-tile);
  border: var(--stroke) solid var(--ink);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.seat--top,
.seat--bottom {
  width: 70%;
  align-self: center;
  min-height: 160rpx;
}

.seat--side {
  width: 220rpx;
  min-height: 200rpx;
}

.seat--dealer {
  border-width: var(--stroke);
}

.seat--hu {
  opacity: 0.45;
}

.seat-pos {
  font-size: 22rpx;
  color: var(--muted);
}

.seat-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  text-align: center;
  word-break: break-all;
}

.seat-chips {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--ink);
  line-height: 1.1;
}

.seat-hu {
  font-size: 22rpx;
  color: var(--muted);
}

.seat-dealer-badge {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--ink);
  background: var(--dealer);
  padding: 4rpx 10rpx;
  border-radius: var(--radius-tile);
}

.bottombar {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
}

.bar-btn {
  flex: 1;
  min-width: 30%;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--ink);
  background: var(--panel);
  border-radius: var(--radius-pill);
  border: var(--stroke-thin) solid var(--ink);
}

.bar-btn::after {
  border: none;
}

.bar-btn--ghost {
  background: transparent;
}

.bar-btn[disabled] {
  opacity: 0.4;
}

.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: var(--mask);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  background: var(--panel);
  border-radius: 24rpx 24rpx 0 0;
  border-top: var(--stroke) solid var(--ink);
}

.settle-sheet {
  width: 86%;
  border-radius: var(--radius-tile);
  border: var(--stroke) solid var(--ink);
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--ink);
}

.confirm-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  margin-top: 8rpx;
  padding: 0;
  box-sizing: border-box;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  color: var(--on-fill);
  background: var(--ink);
  border-radius: var(--radius-pill);
  border: var(--stroke) solid var(--ink);
}

.confirm-btn::after {
  border: none;
}

.settle-list {
  margin: 28rpx 0 36rpx;
}

.settle-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--ink);
}

.settle-name {
  flex: 1;
  font-size: 30rpx;
  color: var(--ink);
}

.settle-delta {
  font-size: 26rpx;
  color: var(--muted);
}

.settle-yuan {
  font-size: 30rpx;
  font-weight: 600;
  min-width: 140rpx;
  text-align: right;
}

.settle-yuan.up {
  color: var(--gain);
}

.settle-yuan.down {
  color: var(--loss);
}

.end-btn {
  margin-top: 20rpx;
  width: 100%;
}
