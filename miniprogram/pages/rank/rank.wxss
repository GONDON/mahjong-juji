.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 80rpx;
  box-sizing: border-box;
  background: var(--paper);
  color: var(--ink);
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: var(--muted);
  font-size: 30rpx;
}

.header {
  margin-bottom: 36rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.sub {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
}

.empty-sm {
  font-size: 24rpx;
  color: var(--muted);
  padding: 12rpx 0 4rpx;
}

.section {
  background: var(--panel);
  border-radius: var(--radius-tile);
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: var(--stroke-thin) solid var(--ink);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 8rpx;
}

.note {
  display: block;
  font-size: 22rpx;
  color: var(--muted);
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
}

.row + .row {
  border-top: 1rpx solid var(--ink);
}

.rank {
  width: 40rpx;
  font-size: 26rpx;
  color: var(--muted);
  text-align: center;
}

.name {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  font-size: 22rpx;
  color: var(--muted);
}

.value {
  min-width: 140rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
}

.value.up {
  color: var(--gain);
}

.value.down {
  color: var(--loss);
}
