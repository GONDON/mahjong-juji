.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 80rpx;
  box-sizing: border-box;
  background: #1a1a1a;
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: #888888;
  font-size: 30rpx;
}

.header {
  margin-bottom: 36rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.sub {
  display: block;
  font-size: 24rpx;
  color: #888888;
}

.empty {
  text-align: center;
  color: #666666;
  font-size: 28rpx;
  padding: 80rpx 0;
}

.empty-sm {
  font-size: 24rpx;
  color: #666666;
  padding: 12rpx 0 4rpx;
}

.section {
  background: #222222;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #333333;
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #f0f0f0;
  margin-bottom: 8rpx;
}

.note {
  display: block;
  font-size: 22rpx;
  color: #7a9a7a;
  margin-bottom: 16rpx;
}

.row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #2e2e2e;
}

.rank {
  width: 40rpx;
  font-size: 26rpx;
  color: #888888;
  text-align: center;
}

.name {
  flex: 1;
  font-size: 28rpx;
  color: #f0f0f0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta {
  font-size: 22rpx;
  color: #666666;
}

.value {
  min-width: 140rpx;
  text-align: right;
  font-size: 28rpx;
  font-weight: 600;
}

.value.up {
  color: #7a9a7a;
}

.value.down {
  color: #c07070;
}
