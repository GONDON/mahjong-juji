.page {
  min-height: 100vh;
  padding: 80rpx 40rpx;
  box-sizing: border-box;
  background: #1a1a1a;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
}

.sub {
  font-size: 26rpx;
  color: #888888;
  text-align: center;
}
