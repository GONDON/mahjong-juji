page {
  background: var(--paper);
}

.page {
  min-height: 100vh;
  padding: 48rpx 32rpx 80rpx;
  box-sizing: border-box;
  background: var(--paper);
  color: var(--ink);
}

.section {
  margin-bottom: 48rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  margin-bottom: 20rpx;
}

.avatar-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.avatar {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--panel);
  border: var(--stroke-thin) solid var(--ink);
  border-radius: var(--radius-tile);
  box-sizing: border-box;
  overflow: hidden;
}

.avatar--on {
  background: var(--peach-wash);
  border-width: var(--stroke);
}

.avatar--pressed {
  opacity: 0.86;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.nick-input {
  height: 96rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: var(--ink);
  background: var(--panel);
  border-radius: var(--radius-tile);
  border: var(--stroke-thin) solid var(--ink);
  box-sizing: border-box;
}

.nick-ph {
  color: var(--muted);
}

.hint {
  display: block;
  margin-bottom: 40rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: var(--muted);
}
