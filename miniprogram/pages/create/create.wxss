.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
  background: #1a1a1a;
}

.section {
  margin-bottom: 56rpx;
}

.label {
  font-size: 28rpx;
  color: #aaaaaa;
  margin-bottom: 24rpx;
}

.chip-row {
  display: flex;
  gap: 24rpx;
}

.chip-btn {
  flex: 1;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #dddddd;
  background: #2a2a2a;
  border-radius: 16rpx;
  border: 2rpx solid #3a3a3a;
}

.chip-btn--on {
  color: #ffffff;
  background: #3d5a3d;
  border-color: #5a8a5a;
}

.nick-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.seat-tag {
  width: 120rpx;
  font-size: 28rpx;
  color: #888888;
  flex-shrink: 0;
}

.nick-input {
  flex: 1;
  height: 88rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: #ffffff;
  background: #2a2a2a;
  border-radius: 12rpx;
  border: 2rpx solid #3a3a3a;
}

.nick-ph {
  color: #666666;
}

.submit-btn {
  margin-top: 24rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  background: #4a7c4a;
  border-radius: 16rpx;
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.55;
}
