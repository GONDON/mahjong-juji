.page {
  min-height: 100vh;
  padding: 48rpx 40rpx 80rpx;
  box-sizing: border-box;
  background: var(--paper);
  color: var(--ink);
}

.section {
  margin-bottom: 56rpx;
}

.label {
  font-size: 28rpx;
  color: var(--ink);
  font-weight: 600;
  margin-bottom: 24rpx;
}

.chip-row {
  display: flex;
  gap: 12rpx;
}

.chip-btn {
  flex: 1;
  height: 96rpx;
  padding: 0 4rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 24rpx;
  font-weight: 700;
  color: var(--ink);
  background: var(--panel);
  border-radius: var(--radius-tile);
  border: var(--stroke-thin) solid var(--ink);
  box-sizing: border-box;
}

.chip-btn--on {
  color: var(--on-fill);
  background: var(--ink);
  border-color: var(--ink);
}

.nick-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.seat-tag {
  width: 120rpx;
  font-size: 28rpx;
  color: var(--muted);
  flex-shrink: 0;
}

.nick-input {
  flex: 1;
  height: 88rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  color: var(--ink);
  background: var(--panel);
  border-radius: var(--radius-tile);
  border: var(--stroke-thin) solid var(--ink);
}

.nick-ph {
  color: var(--muted);
}

.submit-btn {
  margin-top: 24rpx;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--on-fill);
  background: var(--ink);
  border-radius: var(--radius-pill);
  border: var(--stroke) solid var(--ink);
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.55;
}
