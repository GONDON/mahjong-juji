<view class="page">
  <scroll-view class="body" scroll-y="{{!lockingScroll}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="body-clip">
    <view class="identity">
      <view class="profile face-frame" hover-class="profile--pressed" bindtap="onProfileTap">
        <image
          class="profile-face"
          src="{{hasProfile ? profileSrc : '/assets/avatars/avatar_00.svg'}}"
          mode="aspectFit"
        />
      </view>
      <text class="identity-rank" hover-class="identity-rank--pressed" bindtap="onRankTap">年度榜</text>
    </view>
    <view class="section">
      <view class="section-head">
        <image class="badge" src="/assets/dice.svg" mode="aspectFit" />
        <view class="section-copy">
          <text class="section-title">快速开局</text>
          <text class="section-sub">设好底分，邀请牌友用房间码入座</text>
        </view>
      </view>

      <view class="well">
        <view class="field">
          <text class="field-label">底分</text>
          <view class="chip-row">
            <view
              wx:for="{{chipOptions}}"
              wx:key="*this"
              class="chip {{chipValueYuan === item ? 'chip--on' : ''}}"
              hover-class="chip--pressed"
              data-value="{{item}}"
              bindtap="onChipTap"
            >{{item}}</view>
          </view>
        </view>
      </view>

      <button
        class="btn-ink"
        hover-class="btn-ink--pressed"
        loading="{{creating}}"
        disabled="{{creating}}"
        bindtap="onCreateTap"
      >开牌局</button>
    </view>

    <view class="section">
      <view class="section-head">
        <image class="badge" src="/assets/ico-enter.svg" mode="aspectFit" />
        <view class="section-copy">
          <text class="section-title">加入牌局</text>
          <text class="section-sub">输入 4 位房间码，围观或再入已有牌局</text>
        </view>
      </view>

      <view class="code-row">
        <view
          wx:for="{{joinCells}}"
          wx:key="slot"
          class="code-cell {{item.ch ? 'code-cell--on' : ''}} {{item.caret ? 'code-cell--caret' : ''}}"
        >
          <text wx:if="{{item.ch}}">{{item.ch}}</text>
          <view wx:if="{{item.caret}}" class="code-caret"></view>
          <text wx:elif="{{!item.ch}}">-</text>
        </view>
        <block wx:for="{{[joinEpoch]}}" wx:key="*this">
          <input
            class="code-ghost"
            maxlength="4"
            value="{{joinCode}}"
            hold-keyboard
            confirm-type="done"
            bindfocus="onJoinCodeFocus"
            bindblur="onJoinCodeBlur"
            bindinput="onJoinCodeInput"
            bindconfirm="onJoinTap"
          />
        </block>
      </view>

      <button
        class="btn-ghost"
        hover-class="btn-ghost--pressed"
        loading="{{joining}}"
        disabled="{{joining || !canJoin}}"
        bindtap="onJoinTap"
      >加入牌局</button>
    </view>

    <view class="section section--last">
      <view class="section-head">
        <image class="badge" src="/assets/ico-clock.svg" mode="aspectFit" />
        <view class="section-copy">
          <text class="section-title">最近牌局</text>
        </view>
      </view>

      <view wx:if="{{recents.length === 0}}" class="empty-state">
        <image class="empty-state-img" src="/assets/empty.svg" mode="aspectFit" />
        <text>开一局或输入房间码，牌局会出现在这里。</text>
      </view>

      <view
        wx:for="{{recents}}"
        wx:key="sessionId"
        class="swipe"
      >
        <view class="swipe-under">
          <view
            class="swipe-delete"
            hover-class="swipe-delete--pressed"
            data-id="{{item.sessionId}}"
            catchtap="onRecentDelete"
          >删除</view>
        </view>
        <view
          class="campaign {{item.active ? '' : 'campaign--done'}}"
          style="transform: translateX({{item.offsetX}}px);"
          data-id="{{item.sessionId}}"
          bindtouchstart="onRecentTouchStart"
          bindtouchmove="onRecentTouchMove"
          bindtouchend="onRecentTouchEnd"
          bindtouchcancel="onRecentTouchEnd"
          bindtap="onRecentTap"
        >
          <image
            class="campaign-mark"
            src="{{item.active ? '/assets/ico-table.svg' : '/assets/ico-scroll.svg'}}"
            mode="aspectFit"
          />
          <view class="campaign-copy">
            <text class="campaign-title">{{item.title}}</text>
            <text class="campaign-meta">{{item.meta}}</text>
          </view>
          <view
            wx:if="{{item.active}}"
            class="reenter"
            hover-class="reenter--pressed"
            data-id="{{item.sessionId}}"
            catchtap="onReenterTap"
          >再入局</view>
          <text wx:else class="finished">已结束</text>
        </view>
      </view>
    </view>
    </view>
  </scroll-view>
</view>
