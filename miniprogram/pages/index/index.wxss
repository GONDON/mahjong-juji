/* 大厅 — 羊皮纸日间 RPG，DESIGN.md 色板，rpx ≈ 2× px */

page {
  background: #efe6d4;
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #efe6d4;
  color: #1c2e1c;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 8rpx 28rpx 12rpx;
  border-bottom: 4rpx solid #77562f;
  flex-shrink: 0;
}

.brand {
  flex: 1;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: #235b28;
  line-height: 1.2;
}

.tile-mark,
.profile {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.tile-mark {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6rpx;
  padding: 10rpx;
  box-sizing: border-box;
  background: #3e8343;
  border: 4rpx solid #235b28;
  border-radius: 10rpx;
}

.tile-dot {
  width: 12rpx;
  height: 12rpx;
  margin: auto;
  border-radius: 50%;
  background: #efe6d4;
}

.profile {
  position: relative;
  border: 4rpx solid #77562f;
  border-radius: 50%;
  background: #f0e7d6;
  box-sizing: border-box;
}

.profile--pressed {
  background: #dbb155;
}

.profile-head {
  position: absolute;
  top: 10rpx;
  left: 50%;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #77562f;
  transform: translateX(-50%);
}

.profile-body {
  position: absolute;
  right: 10rpx;
  bottom: 6rpx;
  left: 10rpx;
  height: 16rpx;
  border-radius: 16rpx 16rpx 8rpx 8rpx;
  background: #77562f;
}

.body {
  flex: 1;
  height: 0;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 36rpx;
}

.section--last {
  margin-bottom: 16rpx;
  padding-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.section-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
  color: #1c2e1c;
}

.section-sub {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.35;
  color: #5b675b;
}

.badge {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  border-radius: 50%;
  box-sizing: border-box;
}

.badge--meadow {
  background: #3e8343;
  border: 4rpx solid #235b28;
}

.badge--wood {
  background: #77562f;
  border: 4rpx solid #5a3f20;
}

.badge--muted {
  background: #cdc3af;
  border: 4rpx solid #77562f;
}

.plus-h,
.plus-v {
  position: absolute;
  background: #ffffff;
  border-radius: 2rpx;
}

.plus-h {
  top: 20rpx;
  right: 10rpx;
  left: 10rpx;
  height: 4rpx;
}

.plus-v {
  top: 10rpx;
  bottom: 10rpx;
  left: 20rpx;
  width: 4rpx;
}

.enter-box {
  position: absolute;
  top: 12rpx;
  right: 10rpx;
  bottom: 12rpx;
  width: 16rpx;
  border: 3rpx solid #ffffff;
  border-left: 0;
  border-radius: 0 4rpx 4rpx 0;
}

.enter-arrow {
  position: absolute;
  top: 20rpx;
  left: 10rpx;
  width: 16rpx;
  height: 3rpx;
  background: #ffffff;
}

.enter-arrow::after {
  position: absolute;
  top: -6rpx;
  right: -1rpx;
  width: 10rpx;
  height: 10rpx;
  border-right: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(-45deg);
  content: "";
}

.clock-face {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  bottom: 10rpx;
  left: 10rpx;
  border: 3rpx solid #1c2e1c;
  border-radius: 50%;
}

.clock-face::before,
.clock-face::after {
  position: absolute;
  background: #1c2e1c;
  content: "";
}

.clock-face::before {
  top: 8rpx;
  left: 11rpx;
  width: 3rpx;
  height: 10rpx;
}

.clock-face::after {
  top: 16rpx;
  left: 11rpx;
  width: 8rpx;
  height: 3rpx;
}

.well {
  padding: 20rpx 18rpx 22rpx;
  margin-bottom: 18rpx;
  background: #e6d9c0;
  border: 4rpx solid #77562f;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1c2e1c;
}

.chip-row {
  display: flex;
  gap: 16rpx;
}

.chip {
  flex: 1;
  height: 80rpx;
  border: 4rpx solid #77562f;
  border-radius: 10rpx;
  background: #f7f0e2;
  color: #1c2e1c;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.chip--on {
  color: #ffffff;
  background: #3e8343;
  border-color: #235b28;
}

.chip--pressed {
  background: #dbb155;
  color: #1c2e1c;
}

.chip--on.chip--pressed {
  background: #235b28;
  color: #ffffff;
}

.cta {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 104rpx;
  margin: 0;
  padding: 0;
  border-radius: 14rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1;
}

.cta::after {
  border: none;
}

.cta--meadow {
  color: #ffffff !important;
  background: #3e8343;
  background-color: #3e8343;
  border: 6rpx solid #235b28;
}

.cta--meadow::before {
  display: inline-block;
  width: 0;
  height: 0;
  margin-right: 12rpx;
  border-top: 10rpx solid transparent;
  border-bottom: 10rpx solid transparent;
  border-left: 16rpx solid #ffffff;
  vertical-align: middle;
  content: "";
}

.cta--meadow-pressed {
  color: #ffffff;
  background: #235b28;
}

.cta--wood {
  color: #ffffff !important;
  background: #77562f;
  background-color: #77562f;
  border: 6rpx solid #5a3f20;
}

.cta--wood-pressed {
  color: #ffffff;
  background: #5a3f20;
}

.cta[disabled] {
  opacity: 0.55;
}

.code-row {
  position: relative;
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.code-cell {
  flex: 1;
  height: 96rpx;
  border: 4rpx solid #77562f;
  border-radius: 12rpx;
  background: #f7f0e2;
  color: #5b675b;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}

.code-cell--on {
  color: #1c2e1c;
  background: #ffffff;
  border-color: #3e8343;
}

.code-ghost {
  position: absolute;
  inset: 0;
  height: 96rpx;
  padding: 0;
  color: transparent;
  caret-color: #1c2e1c;
  background: transparent;
}

.empty {
  padding: 28rpx 8rpx 8rpx;
  color: #5b675b;
  font-size: 26rpx;
  line-height: 1.45;
}

.campaign {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 12rpx;
  margin-bottom: 12rpx;
  border: 4rpx solid #77562f;
  border-radius: 12rpx;
  background: #f7f0e2;
}

.campaign--done {
  border-color: #cdc3af;
  background: transparent;
}

.campaign-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.campaign-mark--live {
  background: #3e8343;
  border: 4rpx solid #235b28;
}

.campaign-mark--done {
  background: #e6d9c0;
  border: 4rpx solid #cdc3af;
}

.people {
  position: relative;
  width: 32rpx;
  height: 28rpx;
}

.people-a,
.people-b {
  position: absolute;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ffffff;
}

.people-a {
  top: 0;
  left: 0;
}

.people-b {
  top: 6rpx;
  right: 0;
}

.people-a::after,
.people-b::after {
  position: absolute;
  top: 14rpx;
  left: -2rpx;
  width: 18rpx;
  height: 10rpx;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: #ffffff;
  content: "";
}

.flag {
  width: 0;
  height: 0;
  border-top: 8rpx solid transparent;
  border-bottom: 8rpx solid transparent;
  border-left: 18rpx solid #5b675b;
}

.campaign-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.campaign-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1c2e1c;
}

.campaign--done .campaign-title,
.campaign--done .campaign-meta,
.finished {
  color: #5b675b;
}

.campaign-meta {
  font-size: 22rpx;
  font-weight: 500;
  color: #5b675b;
}

.reenter {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 16rpx;
  border: 3rpx solid #77562f;
  border-radius: 10rpx;
  background: #ffffff;
  color: #1c2e1c;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 50rpx;
}

.reenter--pressed {
  background: #dbb155;
}

.finished {
  flex-shrink: 0;
  font-size: 22rpx;
  font-weight: 600;
}

.dock {
  display: flex;
  align-items: stretch;
  flex-shrink: 0;
  padding: 10rpx 12rpx 8rpx;
  border-top: 4rpx solid #77562f;
  background: #efe6d4;
}

.tab {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 88rpx;
  color: #5b675b;
  font-size: 20rpx;
  font-weight: 600;
}

.tab--on {
  color: #ffffff;
  background: #3e8343;
  border: 4rpx solid #235b28;
  border-radius: 16rpx;
}

.tab--pressed {
  background: #e6d9c0;
}

.ico {
  width: 28rpx;
  height: 28rpx;
  position: relative;
}

.ico-home {
  box-sizing: border-box;
  width: 22rpx;
  height: 16rpx;
  margin-top: 8rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
}

.ico-home::before {
  position: absolute;
  top: -10rpx;
  left: -7rpx;
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid currentColor;
  border-right: 3rpx solid currentColor;
  transform: rotate(-45deg);
  content: "";
}

.ico-swords {
  width: 22rpx;
  height: 22rpx;
}

.ico-swords::before,
.ico-swords::after {
  position: absolute;
  top: 9rpx;
  left: -2rpx;
  width: 26rpx;
  height: 4rpx;
  background: currentColor;
  content: "";
}

.ico-swords::before {
  transform: rotate(45deg);
}

.ico-swords::after {
  transform: rotate(-45deg);
}

.ico-scroll {
  box-sizing: border-box;
  border: 3rpx solid currentColor;
  border-radius: 6rpx;
}

.ico-scroll::before,
.ico-scroll::after {
  position: absolute;
  left: 5rpx;
  right: 5rpx;
  height: 3rpx;
  background: currentColor;
  content: "";
}

.ico-scroll::before {
  top: 7rpx;
}

.ico-scroll::after {
  top: 14rpx;
}

.ico-cup {
  box-sizing: border-box;
  width: 16rpx;
  height: 14rpx;
  margin-top: 4rpx;
  border: 3rpx solid currentColor;
  border-bottom: 0;
  border-radius: 0 0 8rpx 8rpx;
}

.ico-cup::before {
  position: absolute;
  top: 14rpx;
  left: 4rpx;
  width: 5rpx;
  height: 8rpx;
  background: currentColor;
  content: "";
}

.tab--on .ico-home,
.tab--on .ico-swords,
.tab--on .ico-scroll,
.tab--on .ico-cup {
  filter: none;
}
