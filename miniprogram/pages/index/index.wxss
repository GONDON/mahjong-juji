page {
  background: var(--paper);
}

.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--paper);
  color: var(--ink);
}

.identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.profile {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.profile-face {
  width: 100%;
  height: 100%;
  display: block;
}

.profile--pressed {
  background: var(--peach-wash);
}

.body {
  flex: 1;
  height: 0;
  padding: 28rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 36rpx;
}

.section--last {
  margin-bottom: 16rpx;
  padding-bottom: 24rpx;
}

.section-head {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 18rpx;
}

.section-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4rpx;
  min-width: 0;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--ink);
}

.section-sub {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.35;
  color: var(--muted);
}

.badge {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
}

.well {
  margin-bottom: 18rpx;
}

.field-label {
  display: block;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--ink);
}

.chip-row {
  display: flex;
  gap: 16rpx;
}

.chip {
  flex: 1;
  height: 80rpx;
  font-size: 32rpx;
  line-height: 72rpx;
}

.code-row {
  position: relative;
  display: flex;
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.code-cell {
  flex: 1;
  height: 96rpx;
  border: var(--stroke-thin) solid var(--ink);
  border-radius: var(--radius-tile);
  background: var(--panel);
  color: var(--muted);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}

.code-cell--on {
  color: var(--ink);
  border-width: var(--stroke);
}

.code-ghost {
  position: absolute;
  inset: 0;
  height: 96rpx;
  padding: 0;
  color: transparent;
  caret-color: var(--ink);
  background: transparent;
}

.campaign {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 12rpx;
  margin-bottom: 12rpx;
  border: var(--stroke-thin) solid var(--ink);
  border-radius: var(--radius-tile);
  background: var(--panel);
}

.campaign--done {
  opacity: 0.55;
}

.campaign-mark {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
}

.campaign-copy {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.campaign-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--ink);
}

.campaign-meta,
.finished {
  font-size: 22rpx;
  font-weight: 500;
  color: var(--muted);
}

.reenter {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 16rpx;
  border: var(--stroke-thin) solid var(--ink);
  border-radius: var(--radius-pill);
  background: var(--panel);
  color: var(--ink);
  font-size: 22rpx;
  font-weight: 700;
  line-height: 50rpx;
}

.reenter--pressed {
  background: var(--peach-wash);
}

.identity-rank {
  padding: 8rpx 4rpx;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--ink);
}

.identity-rank--pressed {
  opacity: 0.55;
}
