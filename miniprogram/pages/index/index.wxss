.page {
  min-height: 100vh;
  padding: 96rpx 48rpx 80rpx;
  box-sizing: border-box;
  background: #1a1a1a;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.brand {
  margin-bottom: 80rpx;
  text-align: center;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 4rpx;
}

.tagline {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #888888;
}

.primary-btn {
  height: 104rpx;
  line-height: 104rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #ffffff;
  background: #4a7c4a;
  border-radius: 16rpx;
  border: none;
  margin-bottom: 48rpx;
}

.join-block {
  margin-bottom: 40rpx;
}

.join-label {
  font-size: 26rpx;
  color: #aaaaaa;
  margin-bottom: 20rpx;
}

.join-row {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.join-input {
  flex: 1;
  height: 88rpx;
  padding: 0 28rpx;
  font-size: 32rpx;
  letter-spacing: 4rpx;
  color: #ffffff;
  background: #2a2a2a;
  border-radius: 12rpx;
  border: 2rpx solid #3a3a3a;
}

.join-ph {
  color: #666666;
  letter-spacing: 0;
}

.join-btn {
  width: 160rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  font-size: 30rpx;
  color: #ffffff;
  background: #3a3a3a;
  border-radius: 12rpx;
  border: none;
}

.join-btn[disabled] {
  opacity: 0.55;
}

.ghost-btn {
  height: 96rpx;
  line-height: 96rpx;
  font-size: 32rpx;
  color: #cccccc;
  background: transparent;
  border-radius: 16rpx;
  border: 2rpx solid #3a3a3a;
}
