.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 80rpx;
  box-sizing: border-box;
  background: #1a1a1a;
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: #888888;
  font-size: 30rpx;
}

.header {
  margin-bottom: 36rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.meta {
  display: block;
  font-size: 26rpx;
  color: #7a9a7a;
  margin-top: 6rpx;
}

.empty {
  text-align: center;
  color: #666666;
  font-size: 28rpx;
  padding: 48rpx 0;
}

.empty-sm {
  font-size: 24rpx;
  color: #666666;
  padding: 8rpx 0;
}

.cycle {
  background: #222222;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #333333;
}

.cycle-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.cycle-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #f0f0f0;
}

.cycle-toggle {
  font-size: 24rpx;
  color: #7a9a7a;
}

.settle-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.settle-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid #2a2a2a;
}

.settle-name {
  flex: 1;
  font-size: 28rpx;
  color: #e0e0e0;
}

.settle-delta {
  font-size: 24rpx;
  color: #888888;
  min-width: 120rpx;
  text-align: right;
}

.settle-yuan {
  font-size: 28rpx;
  font-weight: 600;
  min-width: 140rpx;
  text-align: right;
}

.settle-yuan.up {
  color: #6ecf8e;
}

.settle-yuan.down {
  color: #e07070;
}

.hands {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #333333;
}

.hand {
  margin-bottom: 16rpx;
}

.hand-title {
  display: block;
  font-size: 24rpx;
  color: #aaaaaa;
  margin-bottom: 8rpx;
}

.hu-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx;
}

.hu-main {
  font-size: 26rpx;
  color: #dddddd;
}

.hu-pay {
  font-size: 24rpx;
  color: #888888;
}

.end-btn {
  margin-top: 40rpx;
  background: #3a3a3a;
  color: #e0e0e0;
  border-radius: 12rpx;
  font-size: 28rpx;
}
