.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 80rpx;
  box-sizing: border-box;
  background: var(--paper);
  color: var(--ink);
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: var(--muted);
  font-size: 30rpx;
}

.header {
  margin-bottom: 36rpx;
}

.title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 12rpx;
}

.meta {
  display: block;
  font-size: 26rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

.empty {
  text-align: center;
  color: var(--muted);
  font-size: 28rpx;
  padding: 48rpx 0;
}

.empty-sm {
  font-size: 24rpx;
  color: var(--muted);
  padding: 8rpx 0;
}

.cycle {
  background: var(--panel);
  border-radius: var(--radius-tile);
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: var(--stroke-thin) solid var(--ink);
}

.cycle-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.cycle-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.cycle-toggle {
  font-size: 24rpx;
  color: var(--muted);
}

.settle-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.settle-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 8rpx;
  border-bottom: 1rpx solid var(--ink);
}

.settle-name {
  flex: 1;
  font-size: 28rpx;
  color: var(--ink);
}

.settle-delta {
  font-size: 24rpx;
  color: var(--muted);
  min-width: 120rpx;
  text-align: right;
}

.settle-yuan {
  font-size: 28rpx;
  font-weight: 600;
  min-width: 140rpx;
  text-align: right;
}

.settle-yuan.up {
  color: var(--gain);
}

.settle-yuan.down {
  color: var(--loss);
}

.hands {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--ink);
}

.hand {
  margin-bottom: 16rpx;
}

.hand-title {
  display: block;
  font-size: 24rpx;
  color: var(--muted);
  margin-bottom: 8rpx;
}

.hu-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 4rpx;
}

.hu-main {
  font-size: 26rpx;
  color: var(--ink);
}

.hu-pay {
  font-size: 24rpx;
  color: var(--muted);
}

.end-btn {
  margin-top: 40rpx;
  height: 96rpx;
  line-height: 96rpx;
  background: var(--ink);
  color: var(--on-fill);
  border-radius: var(--radius-pill);
  border: var(--stroke) solid var(--ink);
  font-size: 28rpx;
  font-weight: 700;
}

.end-btn::after {
  border: none;
}
