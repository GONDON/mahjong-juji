.page {
  min-height: 100vh;
  padding: 28rpx 28rpx 80rpx;
  box-sizing: border-box;
  background: var(--paper);
  color: var(--ink);
}

.hint {
  margin-top: 120rpx;
  text-align: center;
  color: var(--muted);
  font-size: 30rpx;
}

.header {
  margin-bottom: 28rpx;
}

.header-row {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.room {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.25;
  letter-spacing: 0.12em;
  color: var(--ink);
}

.status {
  flex-shrink: 0;
  padding: 6rpx 16rpx;
  border: var(--stroke-thin) solid var(--ink);
  border-radius: var(--radius-pill);
  font-size: 22rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--ink);
}

.meta {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1.3;
  color: var(--muted);
}

.empty-sm {
  font-size: 24rpx;
  color: var(--muted);
  padding: 8rpx 0;
}

.cycle {
  background: var(--panel);
  border-radius: var(--radius-tile);
  padding: 8rpx 20rpx 20rpx;
  margin-bottom: 24rpx;
  border: var(--stroke-thin) solid var(--ink);
}

.cycle-head {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  min-height: 72rpx;
  padding: 8rpx 4rpx;
}

.cycle-head--pressed {
  opacity: 0.55;
}

.cycle-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
}

.cycle-toggle {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--muted);
}

.settle-list {
  display: flex;
  flex-direction: column;
}

.settle-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
  padding: 14rpx 4rpx;
}

.settle-face {
  width: 56rpx;
  height: 56rpx;
  border-width: var(--stroke-thin);
  flex-shrink: 0;
  overflow: hidden;
}

.settle-face-img {
  width: 100%;
  height: 100%;
  display: block;
}

.settle-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--ink);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.settle-delta {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--muted);
  min-width: 96rpx;
  text-align: right;
}

.settle-yuan {
  font-size: 30rpx;
  font-weight: 700;
  min-width: 132rpx;
  text-align: right;
}

.settle-yuan.up {
  color: var(--gain);
}

.settle-yuan.down {
  color: var(--loss);
}

.ledger {
  margin-top: 4rpx;
  padding: 28rpx 4rpx 4rpx;
}

.hand + .hand {
  margin-top: 16rpx;
}

.hand-title {
  display: block;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--muted);
  margin-bottom: 6rpx;
}

.hu-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: baseline;
  gap: 16rpx;
  padding: 4rpx 0;
}

.hu-main {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--ink);
}

.hu-pay {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 500;
  color: var(--muted);
}

.end-btn {
  margin-top: 16rpx;
}
