<view class="page">
  <view wx:if="{{loading}}" class="hint">加载中…</view>
  <block wx:else>
    <view class="header">
      <view class="header-row">
        <text class="room">{{roomCode}}</text>
        <text class="status">{{statusLabel}}</text>
      </view>
      <text class="meta">面值 {{chipValueYuan}} 元/牌</text>
    </view>

    <view wx:if="{{cycles.length === 0}}" class="empty-state">
      <image class="empty-state-img" src="/assets/empty.svg" mode="aspectFit" />
      <text>打完一轮并结清后，流水会出现在这里。</text>
    </view>

    <view
      wx:for="{{cycles}}"
      wx:key="index"
      class="cycle"
    >
      <view
        class="cycle-head"
        hover-class="cycle-head--pressed"
        data-index="{{item.index}}"
        bindtap="onToggleCycle"
      >
        <text class="cycle-title">第 {{item.index}} 轮</text>
        <text class="cycle-toggle">{{item.expanded ? '收起' : '流水'}}</text>
      </view>

      <view class="settle-list">
        <view
          wx:for="{{item.settlements}}"
          wx:for-item="row"
          wx:key="playerId"
          class="settle-row"
        >
          <view class="settle-face face-frame">
            <image class="settle-face-img" src="{{row.faceSrc}}" mode="aspectFit" />
          </view>
          <text class="settle-name">{{row.nickname}}</text>
          <text class="settle-delta">{{row.chipLabel}}</text>
          <text class="settle-yuan {{row.yuanClass}}">{{row.yuanLabel}}</text>
        </view>
      </view>

      <view wx:if="{{item.expanded}}" class="ledger">
        <view wx:if="{{item.hands.length === 0}}" class="empty-sm">本轮无局记录</view>
        <view
          wx:for="{{item.hands}}"
          wx:for-item="hand"
          wx:key="index"
          class="hand"
        >
          <text class="hand-title">
            {{hand.title}}
            <text wx:if="{{hand.liuju}}">  流局</text>
          </text>
          <view wx:if="{{hand.hus.length === 0 && !hand.liuju}}" class="empty-sm">无胡</view>
          <view
            wx:for="{{hand.hus}}"
            wx:for-item="hu"
            wx:for-index="huIdx"
            wx:key="huIdx"
            class="hu-row"
          >
            <text class="hu-main">{{hu.line}}</text>
            <text class="hu-pay">{{hu.payLabel}}</text>
          </view>
        </view>
      </view>
    </view>

    <button
      wx:if="{{canEnd}}"
      class="btn-ink end-btn"
      hover-class="btn-ink--pressed"
      bindtap="onEndSession"
      disabled="{{busy}}"
      loading="{{busy}}"
    >结束牌局</button>
  </block>
</view>
