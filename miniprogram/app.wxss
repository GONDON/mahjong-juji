@import "styles/tokens.wxss";

page {
  background-color: var(--paper);
  color: var(--ink);
  font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
}

.btn-ink,
.btn-ghost {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 104rpx;
  margin: 0;
  padding: 0 32rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1;
  border-radius: var(--radius-pill);
}

.btn-ink::after,
.btn-ghost::after {
  border: none;
}

.btn-ink {
  color: var(--on-fill) !important;
  background: var(--ink);
  background-color: var(--ink);
  border: var(--stroke) solid var(--ink);
}

.btn-ink--pressed {
  opacity: 0.86;
}

.btn-ghost {
  color: var(--ink) !important;
  background: transparent;
  background-color: transparent;
  border: var(--stroke) solid var(--ink);
}

.btn-ghost--pressed {
  background: var(--peach-wash);
}

.btn-ink[disabled],
.btn-ghost[disabled] {
  opacity: 0.45;
}

.chip {
  box-sizing: border-box;
  height: 80rpx;
  padding: 0 24rpx;
  border: var(--stroke-thin) solid var(--ink);
  border-radius: var(--radius-tile);
  background: var(--panel);
  color: var(--ink);
  font-size: 28rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.chip--on {
  color: var(--on-fill);
  background: var(--ink);
  border-color: var(--ink);
}

.chip--pressed {
  background: var(--peach-wash);
  color: var(--ink);
}

.chip--on.chip--pressed {
  background: var(--ink);
  color: var(--on-fill);
  opacity: 0.86;
}

.stepper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.stepper-btn {
  width: 80rpx;
  height: 80rpx;
  box-sizing: border-box;
  border: var(--stroke-thin) solid var(--ink);
  border-radius: var(--radius-pill);
  background: var(--panel);
  color: var(--ink);
  font-size: 40rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.stepper-btn--pressed {
  background: var(--peach-wash);
}

.stepper-btn--off {
  opacity: 0.35;
}

.stepper-value {
  flex: 1;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: var(--ink);
}

.tile {
  box-sizing: border-box;
  background: var(--panel);
  border: var(--stroke) solid var(--ink);
  border-radius: var(--radius-tile);
}

.well {
  box-sizing: border-box;
  padding: 20rpx 18rpx 22rpx;
  background: var(--panel);
  border: var(--stroke-thin) solid var(--ink);
  border-radius: var(--radius-tile);
}

.face-frame {
  box-sizing: border-box;
  width: 72rpx;
  height: 72rpx;
  border: var(--stroke) solid var(--ink);
  border-radius: var(--radius-tile);
  background: var(--panel);
}

.hint-copy {
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.45;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 16rpx;
  color: var(--muted);
  font-size: 26rpx;
  line-height: 1.45;
  text-align: center;
}

.empty-state-img {
  width: 120rpx;
  height: 120rpx;
}

.yuan-up {
  color: var(--gain);
}

.yuan-down {
  color: var(--loss);
}
